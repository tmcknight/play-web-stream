[Unit]
Description=play-web-stream LAN resolver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python __DIR__/webapp.py --port 8786
Restart=on-failure
RestartSec=3
# The proxies are detached children with their own idle timeout, and must survive a
# restart of this unit.
KillMode=process

# Upstream fetches go through this proxy, so stream origins see its address instead
# of this connection's. The LAN is still reached directly. Any HTTP proxy works;
# docker-compose.vpn.yml sets one up on a VPN. For why this is not https_proxy, see
# "Keep your address private" in README.md.
#Environment=PWS_EGRESS_PROXY=http://127.0.0.1:8888

# Under Docker the container is the boundary. Installed this way there is none, so
# these settings replace it: the app runs as you and drives a real browser over
# arbitrary pages. This matches the container setup described in "What the container
# is holding" in SECURITY.md.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The only writable path: AirPlay credentials, once per receiver. install.sh
# creates it. If it is missing the unit fails to start, instead of pairing failing
# later.
ReadWritePaths=__HOME__/.config/play-web-stream
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
# Nothing here binds a port below 1024, so it needs no capability at all.
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictRealtime=true
SystemCallArchitectures=native
# 0077 because pyatv writes the paired credentials itself and we do not control
# their mode. The proxies already open their own files 0600.
UMask=0077

# Not set, because each one breaks the app:
#
#   PrivateTmp=      A fresh /tmp per start. The detached proxies keep using the old
#                    one, so a restarted app could not see or stop its own streams.
#                    Same reason as KillMode=process above.
#   RestrictNamespaces=
#                    Chromium's sandbox uses user namespaces. Here, unlike in the
#                    container, it is on and useful; this would disable it with no
#                    error.
#   SystemCallFilter=
#                    A browser needs syscalls a normal service does not. Chromium
#                    dies at launch with an unhelpful message.
#   RestrictAddressFamilies=
#                    Chromium needs netlink for network-change detection and unix
#                    sockets between its own processes.
#   ProcSubset=pid   Chromium reads /proc/cpuinfo and /proc/meminfo to size itself.
#   MemoryDenyWriteExecute=
#                    V8's JIT writes compiled JavaScript to memory and executes it.
#
# MemoryMax=2G       Optional. Left off because the OOM kill takes the whole app,
#                    streams included.

[Install]
WantedBy=multi-user.target
